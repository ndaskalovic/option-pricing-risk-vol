"""The supported-operations API. Kernels are written once, generic over `N: ADNum`.

The implementation is `TraceNum`: `Compiled` evaluates a kernel on it inside the compiler
to capture its graph, then emits straight-line forward and reverse code.
Comparisons are only available through `select_gt`, so every kernel is branch-free
on differentiable values: the graph is identical on every call.
"""


trait ADNum(ImplicitlyCopyable, Movable, Deinitable):
    def __add__(self, rhs: Self) -> Self: ...
    def __add__(self, rhs: Float64) -> Self: ...
    def __radd__(self, lhs: Float64) -> Self: ...
    def __sub__(self, rhs: Self) -> Self: ...
    def __sub__(self, rhs: Float64) -> Self: ...
    def __rsub__(self, lhs: Float64) -> Self: ...
    def __mul__(self, rhs: Self) -> Self: ...
    def __mul__(self, rhs: Float64) -> Self: ...
    def __rmul__(self, lhs: Float64) -> Self: ...
    def __truediv__(self, rhs: Self) -> Self: ...
    def __truediv__(self, rhs: Float64) -> Self: ...
    def __rtruediv__(self, lhs: Float64) -> Self: ...
    def __neg__(self) -> Self: ...
    def __pow__(self, k: Float64) -> Self: ...
    def exp(self) -> Self: ...
    def log(self) -> Self: ...
    def sqrt(self) -> Self: ...
    def relu(self) -> Self: ...
    def detach(self) -> Self:
        """Same value, zero derivative (like JAX's stop_gradient)."""
        ...
    def constant(self, k: Float64) -> Self:
        """A constant of the same kind as `self` (same graph)."""
        ...

    @staticmethod
    def select_gt(a: Self, b: Self, x: Self, y: Self) -> Self:
        """`x` where a > b, else `y` (lane-wise). Derivative flows only into the chosen branch."""
        ...


@always_inline
def maximum[N: ADNum](a: N, b: N) -> N:
    return N.select_gt(a, b, a, b)


@always_inline
def minimum[N: ADNum](a: N, b: N) -> N:
    return N.select_gt(a, b, b, a)
